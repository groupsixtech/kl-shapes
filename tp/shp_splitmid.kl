PROGRAM shp_splitmid
%NOBUSYLAMP
%NOLOCKGROUP

VAR
	out_reg : INTEGER
	out_grp : INTEGER
	pr_num1 : INTEGER
	p1 : VECTOR
	pr_num2 : INTEGER
	p2 : VECTOR
	pr_num3 : INTEGER
	p3 : VECTOR
	pr_num4 : INTEGER
	p4 : VECTOR
	pr_num5 : INTEGER
	p5 : VECTOR
	pr_num6 : INTEGER
	p6 : VECTOR
%include tpe.vars.klh
%from registers.klh %import set_vector
%from pose.klh %import get_posreg_xyz, get_posreg_joint, set_posreg_xyz, set_posreg_joint, set_vector_to_posreg
%from shapes.klh %import plane_intersection_euler

BEGIN
	pr_num1 = tpe__get_int_arg(1)
	pr_num2 = tpe__get_int_arg(2)
	pr_num3 = tpe__get_int_arg(3)
	pr_num4 = tpe__get_int_arg(4)
	pr_num5 = tpe__get_int_arg(5)
	pr_num6 = tpe__get_int_arg(6)
	p1 = tpe__get_vector_arg(pr_num1)
	p2 = tpe__get_vector_arg(pr_num2)
	p3 = tpe__get_vector_arg(pr_num3)
	p4 = tpe__get_vector_arg(pr_num4)
	p5 = tpe__get_vector_arg(pr_num5)
	p6 = tpe__get_vector_arg(pr_num6)
	out_reg = tpe__get_int_arg(7)
	pose__set_vector_to_posreg(shapes__plane_intersection_euler(p1,p2,p3,p4,p5,p6), out_reg)
END shp_splitmid
%ifndef shapes_h
%define shapes_h

%include namespace.m

%define prog_name shapes
%define prog_name_alias shape


%ifdef shapes_t
-- create plane from normal.
declare_function(prog_name,create_plane,prog_name_alias,cpln)
ROUTINE shapes__create_plane(origin : VECTOR; normal_vec : VECTOR; out_plane : t_PLANE) FROM shapes
-- create a plane from 3 points
declare_function(prog_name,create_plane_from_points,prog_name_alias,cplnfp)
ROUTINE shapes__create_plane_from_points(p1 : VECTOR; p2 : VECTOR; p3 : VECTOR) : t_PLANE FROM shapes
declare_function(prog_name,plane_intersection_line,prog_name_alias,crplin)
ROUTINE shapes__plane_intersection_line(pl1 : t_PLANE; pl2 : t_PLANE) : t_LINE FROM shapes
declare_function(prog_name,vector_from_2planes,prog_name_alias,plintl)
ROUTINE shapes__vector_from_2planes(p1: VECTOR; p2: VECTOR; p3: VECTOR; p4: VECTOR; p5: VECTOR; p6 : VECTOR) : VECTOR FROM shapes
declare_function(prog_name,euler_from_2planes,prog_name_alias,plinte)
ROUTINE shapes__euler_from_2planes(p1: VECTOR; p2: VECTOR; p3: VECTOR; p4: VECTOR; p5: VECTOR; p6 : VECTOR) : VECTOR FROM shapes
declare_function(prog_name,plane_intersection_bicsector,prog_name_alias,crpbsc)
ROUTINE shapes__plane_intersection_bicsector(pl1 : t_PLANE; pl2 : t_PLANE) : VECTOR FROM shapes
declare_function(prog_name,bisector_from_2planes,prog_name_alias,bi2pln)
ROUTINE shapes__bisector_from_2planes(p1: VECTOR; p2: VECTOR; p3: VECTOR; p4: VECTOR; p5: VECTOR; p6 : VECTOR) : VECTOR FROM shapes
declare_function(prog_name,bisector_from_2planes_euler,prog_name_alias,bi2ple)
ROUTINE shapes__bisector_from_2planes_euler(p1: VECTOR; p2: VECTOR; p3: VECTOR; p4: VECTOR; p5: VECTOR; p6 : VECTOR) : VECTOR FROM shapes

declare_function(prog_name,project_point_on_plane,prog_name_alias,prjpln)
ROUTINE shapes__project_point_on_plane(point : VECTOR; plane : t_PLANE) : VECTOR FROM shapes
declare_function(prog_name,distance_of_point_to_plane,prog_name_alias,dstpln)
ROUTINE shapes__distance_of_point_to_plane(point : VECTOR; plane : t_PLANE) : REAL FROM shapes

%else
%warning 'shapes.klt needs to be included to use shapes.klh header'
%endif

%endif --shapes_h